# AWS Configuration
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_REGION=us-east-1
AWS_PROFILE=default

# Bedrock Configuration
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.7

# Database Connection - Metadata Store (PostgreSQL)
POSTGRES_METADATA_HOST=localhost
POSTGRES_METADATA_PORT=5432
POSTGRES_METADATA_DATABASE=migration_metadata
POSTGRES_METADATA_USER=postgres
POSTGRES_METADATA_PASSWORD=postgres_dev_password

# Database Connection - Sample Databases (for testing)
# PostgreSQL Sample
POSTGRES_SAMPLE_HOST=localhost
POSTGRES_SAMPLE_PORT=5433
POSTGRES_SAMPLE_DATABASE=sample_source
POSTGRES_SAMPLE_USER=postgres
POSTGRES_SAMPLE_PASSWORD=postgres_dev_password

# MySQL Sample
MYSQL_SAMPLE_HOST=localhost
MYSQL_SAMPLE_PORT=3306
MYSQL_SAMPLE_DATABASE=sample_source
MYSQL_SAMPLE_USER=appuser
MYSQL_SAMPLE_PASSWORD=mysql_dev_password

# Oracle Sample (dedicated sample_user schema in the XEPDB1 pluggable DB,
# not sys/sysdba in the CDB root -- see infra/docker/oracle-sample-init.sql)
ORACLE_SAMPLE_HOST=localhost
ORACLE_SAMPLE_PORT=1521
ORACLE_SAMPLE_SERVICE_NAME=XEPDB1
ORACLE_SAMPLE_USER=sample_user
ORACLE_SAMPLE_PASSWORD=oracle_dev_password

# API Server Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_RELOAD=true
FASTAPI_DEBUG=true

# Stub API-key auth (Phase 1). Leave unset for local dev (auth disabled with a
# warning); set to a real secret before exposing the API beyond localhost.
AUTH_API_KEY=

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_LOGGER_LEVEL=debug
MIGRATION_API_BASE_URL=http://localhost:8000

# LangFuse Configuration (Observability)
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true

# LangSmith Configuration (Alternative observability)
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=migration-platform
LANGSMITH_TRACING_ENABLED=false

# Application Configuration
LOG_LEVEL=INFO
DEBUG=false
ENVIRONMENT=development
TIMEZONE=UTC

# S3 Configuration (for checkpoint/backup storage)
S3_BUCKET=migration-platform-state
S3_CHECKPOINT_PREFIX=checkpoints/
S3_BACKUP_PREFIX=backups/

# Kubernetes Configuration (for Phase 8+)
KUBE_CONTEXT=default
KUBE_NAMESPACE=default
DEPLOYMENT_ENV=local

# Tool Adapter Configuration
CRACKSQL_ENABLED=true
OPENREWRITE_ENABLED=true
AIDER_ENABLED=true
SEATUNNEL_ENABLED=true
TERRAFORM_ENABLED=true
KUBECTL_ENABLED=true

# Optional: Custom settings
# CUSTOM_SETTING_1=value1
